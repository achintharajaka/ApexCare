# ==============================================================================
# APEXCARE HMS - PRODUCTION & RENDER.COM ENVIRONMENT CONFIGURATION
# ==============================================================================

NODE_ENV=production
# Render automatically injects PORT (e.g. 10000); default to 5000 locally
PORT=5000

# ------------------------------------------------------------------------------
# 1. INTERNATIONAL STANDARD DATA ENCRYPTION (AES-256-GCM / HIPAA / ISO 27001)
# ------------------------------------------------------------------------------
# Master 256-bit encryption key used to encrypt all ePHI, patient biodata, and records at rest.
# MUST be at least 32 characters long.
ENCRYPTION_SECRET=apexcare-aes-256-gcm-master-encryption-key-32-chars-2026

# Optional: Render Persistent Disk Mount Directory (if you attach a disk on Render, e.g. /var/data)
# DATA_DIR=/var/data

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & ACCESS CONTROL
# ------------------------------------------------------------------------------
JWT_SECRET=apexcare-clinical-jwt-secret-key-32-chars-minimum-2026

# ------------------------------------------------------------------------------
# 3. CORS & HOSTING DOMAINS (GITHUB PAGES + RENDER.COM)
# ------------------------------------------------------------------------------
# Your frontend URL on GitHub Pages: https://<username>.github.io/<repo-name>
FRONTEND_URL=https://your-github-username.github.io/ApexCare
APP_TRUSTED_ORIGIN=https://your-github-username.github.io

# Comma-separated list of allowed origins (e.g. your GitHub Pages domain and custom domain)
CORS_ALLOWED_ORIGINS=https://your-github-username.github.io,http://localhost:5173

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY (BILLING MODULE WEBHOOK INTEGRATION)
# ------------------------------------------------------------------------------
PAYMENT_GATEWAY_WEBHOOK_SECRET=payment-gateway-webhook-secret-key-32-chars-min
PAYMENT_GATEWAY_ALLOWED_IPS=127.0.0.1,::1,localhost
